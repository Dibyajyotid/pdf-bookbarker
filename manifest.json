{
    "manifest_version": 3,
    "name": "PDF Bookmarker",
    "version": "1.0",
    "description": "A simple extension to bookmark PDF files.",
    "permissions": [
        "storage",
        "activeTab"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>", "file://*/*", "chrome-extension://*/*"],
            "js": ["content.js"],
            "all_frames": true
        }
    ],

    "action": {
        "default_popup": "popup/popup.html"
    }
}